{
    "setupTimeout": "240s",
    "maxRedirects": 0,
    "summaryTrendStats": [
        "avg",
        "min",
        "med",
        "max",
        "p(95)",
        "p(99)",
        "p(99.99)",
        "count"
    ],
    "scenarios": {
        "payment_events": {
            "executor": "ramping-arrival-rate",
            "timeUnit": "1s",
            "startRate": 10,
            "preAllocatedVUs": 100,
            "maxVUs": 600,
            "stages": [
                {
                    "target": 10,
                    "duration": "5m"
                },
                {
                    "target": 92,
                    "duration": "5m"
                },
                {
                    "target": 92,
                    "duration": "10m"
                },
                {
                    "target": 140,
                    "duration": "3m"
                },
                {
                    "target": 140,
                    "duration": "15m"
                },
                {
                    "target": 200,
                    "duration": "3m"
                },
                {
                    "target": 200,
                    "duration": "30m"
                },
                {
                    "target": 0,
                    "duration": "2m"
                }
            ]
        }
    },
    "thresholds": {
        "http_req_failed{name:producePayment}": [
            {
                "threshold": "rate<0.01",
                "abortOnFail": true,
                "delayAbortEval": "1m"
            }
        ],
        "http_req_duration{name:producePayment}": [
            {
                "threshold": "p(99)<1500",
                "abortOnFail": true,
                "delayAbortEval": "1m"
            }
        ],
        "dropped_iterations": [
            {
                "threshold": "count<100",
                "abortOnFail": true,
                "delayAbortEval": "1m"
            }
        ]
    }
}
